# Flood & Damage Triage - environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.

# --- Cloud LLM (OpenAI-compatible) -------------------------------------------
# Used first for triage field notes. If unset/unreachable the app falls back to
# a local Ollama model, then to a deterministic metric-based note.
LLM_API_KEY=
# Full endpoint or base URL. Examples:
#   https://api.openai.com/v1
#   https://api.openai.com/v1/chat/completions
#   https://api.groq.com/openai/v1
LLM_BASE_URL=
# Model id, e.g. gpt-4o-mini / llama-3.3-70b-versatile / deepseek-chat
LLM_MODEL=

# Optional tuning
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.2

# --- Local Ollama (optional fallback) ----------------------------------------
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=moondream
